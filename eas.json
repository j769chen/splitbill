{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "internal": {
      "environment": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "internal-apk": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
